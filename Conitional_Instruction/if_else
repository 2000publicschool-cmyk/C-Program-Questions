#include <stdio.h>

int main() {
    char ch;

    // Take character input from the user
    printf("Enter a character: ");
    scanf("%c", &ch);

    // Check if the ASCII value falls between 'a' and 'z'
    if (ch >= 'a' && ch <= 'z') {
        printf("'%c' is a lowercase character.\n", ch);
    } else {
        printf("'%c' is NOT a lowercase character.\n", ch);
    }

    return 0;
}
